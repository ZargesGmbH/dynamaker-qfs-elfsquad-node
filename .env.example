ElfsquadClientId=your_elfsquad_client_id
ElfsquadClientSecret=your_elfsquad_client_secret

# --- Which service renders which configurator model -----------------------------------
# Two options; both may be used together. See README.md for the field reference.

# Option 1 — DynaMaker only (the simple case). Maps each DynaMaker application to the
# Elfsquad configurator model IDs it renders.
# Format: <applicationId>:<modelId>,<modelId>;<applicationId>:<modelId> — entries separated by
# semicolons, model IDs by commas, no spaces. An application may list several model IDs.
# These models go to DynaMaker QFS using the QfsApiKey/QfsEnvironment/QfsTaskName below.
DynamakerApplicationToElfsquadModelsMap=your_dynamaker_application_id:your_elfsquad_config_model_id

QfsApiKey=your_qfs_api_key
QfsEnvironment=test
QfsTaskName=generate-pdf

# Option 2 — the general case: a JSON array where every entry carries its own
# destination, so different configurator models can be routed to different job services.
# Needed to point individual models at a service other than DynaMaker QFS while the rest
# stay on it. Takes precedence for any model ID listed in both options.
#
# applicationId/task/environment are DynaMaker-specific and only needed for entries
# targeting DynaMaker QFS; apiKeyHeader defaults to "qfs-api-key" (DynaMaker's header)
# if omitted.
#JobServicesByModelId=[{"modelIds":["your_other_model_id"],"url":"https://your-other-job-service.example/jobs","apiKeyHeader":"x-api-key","apiKey":"your_other_service_api_key"}]
