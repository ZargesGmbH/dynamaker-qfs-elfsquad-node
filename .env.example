ElfsquadClientId=your_elfsquad_client_id
ElfsquadClientSecret=your_elfsquad_client_secret

# Routes each supported Elfsquad configurator model ID to the job service that renders
# it. A JSON array; each entry lists the model IDs it covers plus that service's
# endpoint and auth. DynaMaker QFS is the default/primary target this project was built
# for, but any other service speaking the same job/callback protocol works too. Mix and
# match per model ID, e.g. to route one configurator to a different service while the
# others stay on DynaMaker. See README.md for details.
#
# applicationId/task/environment are DynaMaker-specific and only needed for entries
# targeting DynaMaker QFS; apiKeyHeader defaults to "qfs-api-key" (DynaMaker's header)
# if omitted.
JobServicesByModelId=[{"modelIds":["your_dynamaker_model_id_1","your_dynamaker_model_id_2"],"url":"https://qfs.dynamaker.com/jobs","applicationId":"your_dynamaker_application_id","task":"generate-pdf","environment":"production","apiKey":"your_qfs_api_key"},{"modelIds":["your_other_model_id"],"url":"https://your-other-job-service.example/jobs","apiKeyHeader":"x-render-api-key","apiKey":"your_other_service_api_key"}]
