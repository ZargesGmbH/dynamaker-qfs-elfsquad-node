ElfsquadClientId=your_elfsquad_client_id
ElfsquadClientSecret=your_elfsquad_client_secret

# --- Which service renders which configurator model -----------------------------------
# A JSON array in which every entry carries its own destination, so different Elfsquad
# configurator models can be routed to different job services. Configurations whose model
# ID is not listed here are skipped. See README.md for the full field reference.
#
# Per entry:
#   modelIds      (required) Elfsquad configurator model IDs handled by this service.
#   url           (required) Job endpoint, e.g. https://qfs.dynamaker.com/jobs
#   apiKey        (required) Shared secret sent in the auth header.
#   apiKeyHeader  (optional) Auth header name; defaults to qfs-api-key (DynaMaker's).
#   applicationId (DynaMaker) The DynaMaker application rendering these models. Its
#                 presence is what makes the job payload DynaMaker-shaped.
#   task          (optional) DynaMaker task name; defaults to generate-pdf.
#   environment   (optional) DynaMaker environment, e.g. test or production.
#
# Write it as one line without spaces, and without surrounding quotes. Each model ID may
# appear only once across all entries.
JobServicesByModelId=[{"modelIds":["your_elfsquad_config_model_id"],"url":"https://qfs.dynamaker.com/jobs","apiKey":"your_qfs_api_key","applicationId":"your_dynamaker_application_id","task":"generate-pdf","environment":"test"},{"modelIds":["your_other_model_id"],"url":"https://your-other-job-service.example/jobs","apiKeyHeader":"x-api-key","apiKey":"your_other_service_api_key"}]
